# Environment variables for local development with `cargo lambda watch`.
# Copy to `.env` and adjust values as needed.

# Required — comma-separated 12-digit AWS account ids and/or TopicArn globs.
# Empty = accept everything (development only).
ALLOWED_TOPICS=

# Optional — EUM opt-out list name for STOP/START keyword handling.
# Leave empty to disable opt-out actions.
OPT_OUT_LIST_NAME=

# Optional — EventBridge event source field (default: aws-messaging-webhook).
EVENT_SOURCE=aws-messaging-webhook

# Optional — DynamoDB table name.
TABLE_NAME=aws-messaging-webhook-dev-events

# Optional — EventBridge bus name.
EVENT_BUS_NAME=aws-messaging-webhook-dev-events

# Optional — CloudWatch metrics namespace (stack name).
STACK_NAME=aws-messaging-webhook-dev

# Optional — auto-resubscribe on abusive unsubscribe (default: true).
AUTO_RESUBSCRIBE=true

# Optional — TTL in days for raw event items (default: 30).
RAW_EVENT_RETENTION_DAYS=30

# Optional — TTL in days for aggregate items (default: 365).
AGGREGATE_RETENTION_DAYS=365

# Debug only — override SNS certificate fetch host for local fake SNS.
# Only works in debug builds (compiled out in release).
# SNS_CERT_HOST_OVERRIDE=http://localhost:4566

# Optional — log level filter.
# RUST_LOG=aws_messaging_webhook=debug
